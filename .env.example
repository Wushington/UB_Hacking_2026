# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (dashboard → API keys). Enable Google as a social connection in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Google Gemini (server only)
GEMINI_API_KEY=replace_me

# ElevenLabs text-to-speech for "Listen" to AI feedback (server only).
# Voice and model are optional; defaults: JBFqnCBsd6RMkjVDRZzb, eleven_flash_v2_5.
ELEVENLABS_API_KEY=replace_me
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Tiger Data managed PostgreSQL (server only)
DATABASE_URL=postgres://tsdbadmin:replace_me@replace-me.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Vultr Object Storage, private bucket (server only)
# Endpoint needs https://. Bucket is the bare name (not the "%(bucket)s.<host>" template from s3cmd).
# After creating the bucket, run `npm run storage:cors` once so browsers can upload recordings.
VULTR_S3_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_S3_REGION=ewr1
VULTR_S3_BUCKET=orbit-study
VULTR_S3_ACCESS_KEY_ID=replace_me
VULTR_S3_SECRET_ACCESS_KEY=replace_me
