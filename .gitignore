# =============================================================================
# Secrets & environment
# =============================================================================
# Never commit real values; the template stays tracked.
.env*
!.env.example
*.pem

# Clerk CLI / keyless-mode claim files (contain app credentials)
.clerk/

# =============================================================================
# JavaScript / TypeScript (Next.js web app)
# =============================================================================
# Dependencies
node_modules/

# Next.js build output
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# Tests (Vitest coverage)
/coverage/

# Package manager logs
npm-debug.log*

# Vercel
.vercel/

# =============================================================================
# Python (src/ai-service FastAPI service)
# =============================================================================
# Byte-compiled files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Packaging
*.egg-info/
dist/

# Tooling caches & test/coverage reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# =============================================================================
# Editors & OS
# =============================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code per-user settings
.claude/settings.local.json

# =============================================================================
# Logs
# =============================================================================
*.log
